[12.015309, "o", "\u001b[33m9e5a119\u001b[m\u001b[33m (\u001b[m\u001b[1;36mHEAD -> \u001b[m\u001b[1;32mmain\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/demo-prep\u001b[m\u001b[33m)\u001b[m Add demo-backup transcript + slide drafts for the demo\u001b[m\r\n\u001b[33m573108b\u001b[m Add demo runbook, architecture map, and end-to-end demo scripts\u001b[m\r\n\u001b[33m0b95fd5\u001b[m\u001b[33m (\u001b[m\u001b[1;31morigin/main\u001b[m\u001b[33m, \u001b[m\u001b[1;31morigin/HEAD\u001b[m\u001b[33m)\u001b[m Switch image publish target from ECR to DockerHub (seadas/find-make-matchup\u001b[m \b\u001b[33m\u001b[m\u001b[33m\u001b[m\u001b[1;31m\u001b[m\u001b[33m\u001b[m\u001b[1;31m\u001b[m\u001b[33m\u001b[m-harmony)\u001b[m\r\n\u001b[33mcfea168\u001b[m Move publish-image workflow to repo root so Actions picks it up\u001b[m\r\n\u001b[33m6fdd48d\u001b[m Ignore Codex CLI workspace marker\u001b[m\r\n\u001b[33ma562d01\u001b[m Add top-level py-compile CI workflow for syntax checks\u001b[m\r\n\u001b[33m7b64976\u001b[m Add AGENTS.md with repository guidelines\u001b[m\r\n\u001b[33m2eb44f4\u001b[m Update design docs to reference find-make-matchup-harmony\u001b[m\r\n"]
